<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Directory holding the custom CounterStrikeSharp API assemblies from
         build 1.0.371-16 (commit 2ca60003, GitHub Actions run 29164204856).
         Override with -p:CssApiDir=/path/to/publish -->
    <CssApiDir Condition="'$(CssApiDir)' == ''">$(MSBuildThisFileDirectory)cssharp-api</CssApiDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the custom CounterStrikeSharp build instead of the NuGet package.
         Private=false mirrors the old ExcludeAssets=runtime: the server supplies these at runtime. -->
    <Reference Include="CounterStrikeSharp.API">
      <HintPath>$(CssApiDir)/CounterStrikeSharp.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.Localization.Abstractions">
      <HintPath>$(CssApiDir)/Microsoft.Extensions.Localization.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>$(CssApiDir)/Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="CsvHelper" Version="30.0.1" />
    <PackageReference Include="Dapper" Version="2.1.15" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="7.0.13" />
    <PackageReference Include="MySqlConnector" Version="2.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.6" />
  </ItemGroup>
  <ItemGroup>
    <None Update="lang\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="spawns\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
